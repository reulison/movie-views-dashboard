{
    "name": "movie-views-dashboard",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "features": {
        // Allows `astro dev start` to run its local Airflow containers.
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": false
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "astro-build.astro-vscode"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.terminal.activateEnvironment": false,
                "files.associations": {
                    "*.sql": "sql"
                }
            }
        }
    },
    "containerEnv": {
        "AIRFLOW_HOME": "/usr/local/airflow"
    },
    "remoteEnv": {
        "PATH": "/home/astro/.local/bin:${containerEnv:PATH}"
    },
    "postCreateCommand": "pip install -r requirements.txt && mkdir -p /home/astro/.local/bin && curl -fsSL https://raw.githubusercontent.com/astronomer/astro-cli/main/godownloader.sh | sh -s -- -b /home/astro/.local/bin",
    "remoteUser": "astro"
}
